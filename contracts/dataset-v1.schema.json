{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dataflow.local/contracts/dataset-v1.schema.json",
  "title": "DataFlow Dataset v1",
  "type": "object",
  "required": ["schema", "records"],
  "properties": {
    "schema": {"$ref": "data-schema-v1.schema.json"},
    "records": {"type": "array", "maxItems": 10000, "items": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean", "null"]}}},
    "metadata": {"type": "object"}
  },
  "additionalProperties": false
}
