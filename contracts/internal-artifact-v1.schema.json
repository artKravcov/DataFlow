{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dataflow.local/contracts/internal-artifact-v1.schema.json",
  "$defs": {
    "headers": {
      "type": "object", "additionalProperties": false,
      "required": ["worker_id", "lease_token", "node_id", "content_sha256"],
      "properties": {
        "worker_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._-]+$"},
        "lease_token": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "node_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "response": {"type": "object", "additionalProperties": false, "required": ["data"], "properties": {"data": {"type": "object", "additionalProperties": false, "required": ["asset_id"], "properties": {"asset_id": {"type": "string", "pattern": "^[1-9][0-9]{0,17}$"}}}}}
  }
}
