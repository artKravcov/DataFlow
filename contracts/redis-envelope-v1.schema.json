{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dataflow.local/contracts/redis-envelope-v1.schema.json",
  "title": "DataFlow execution envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["message_version", "message_id", "execution_id"],
  "properties": {
    "message_version": {"const": 1},
    "message_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "execution_id": {"type": "string", "pattern": "^[1-9][0-9]{0,17}$"}
  }
}
